# These are settings for the backend. Locally you can leave them all unset:
# the app then uses a SQLite file (sales.db) and allows the Vite dev server.
# Online (Vercel) you set them in the project's Environment Variables.

# Hosted Postgres connection string (Neon, Supabase, ...). Required on Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Web addresses allowed to call the API, comma separated, no trailing slash.
CORS_ORIGINS=https://your-web-app.vercel.app

# Optional: also allow Vercel preview deployments.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
