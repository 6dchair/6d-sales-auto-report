# Address of the backend API (no trailing slash).
# Local development: leave this unset; the app uses http://127.0.0.1:8000.
# Vercel: add VITE_API_BASE_URL under the web project's Environment Variables,
# then redeploy (the value is baked in when the site is built).
VITE_API_BASE_URL=https://your-api.vercel.app
